# Backend
PORT=4000
# Use the full deployed frontend origin, for example https://your-lava-mart.vercel.app
CORS_ORIGIN=http://localhost:5173
# Required only for the secured admin dashboard
ADMIN_KEY=replace-with-a-long-random-secret
# Optional persistent data directory; on Render, mount a persistent disk here
DATA_DIR=./data
# Optional AI-compatible Chat Completions API
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions

# Frontend (.env file inside client/)
# VITE_SOCKET_URL=http://localhost:4000
# Optional WebRTC ICE server JSON. Configure a TURN provider for better cross-network voice reliability.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"temporary-user","credential":"temporary-secret"}]
